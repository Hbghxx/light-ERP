# 复制本文件为 .env 后修改(docker compose 自动读取同目录 .env)
# 数据库 root 密码 —— 生产/公网环境必须更换,.env 不要提交进 git
MYSQL_ROOT_PASSWORD=please-change-me
# Grafana 管理员密码(监控栈: docker compose --profile monitoring up -d)
GRAFANA_ADMIN_PASSWORD=please-change-me-too
# 告警 webhook(钉钉/企微/飞书自定义机器人地址;留空则告警只写日志)
# ALERT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
